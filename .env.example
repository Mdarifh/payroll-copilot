# Copy this file to .env and fill real values. Never commit .env.

# ---------- App ----------
APP_ENV=dev                     # dev | test | prod
LOG_LEVEL=INFO                  # DEBUG | INFO | WARNING | ERROR
LOG_FORMAT=text                 # text | json
COMPANY_NAME=Demo Tech Pvt Ltd
COMPANY_STATE=MH

# ---------- Database ----------
# SQLite for now; later e.g. postgresql+psycopg://user:pass@host:5432/payroll
DATABASE_URL=sqlite:///./data/chatbot.db

# ---------- Auth ----------
# At least 32 random characters. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# Empty in dev = random key per run (everyone is logged out when the API restarts).
JWT_SECRET=
JWT_EXPIRE_MINUTES=480

# ---------- LLM (picks tools and words answers; never calculates payroll) ----------
# ollama    = free, local (https://ollama.com, then `ollama pull qwen2.5:7b`)
# anthropic = Claude API: needs an API key from console.anthropic.com (billed per use;
#             a claude.ai / Claude Code subscription login does NOT work here)
# none      = chat says the assistant is switched off
LLM_PROVIDER=ollama
LLM_MAX_STEPS=6                   # model calls per chat message
OLLAMA_MODEL=qwen2.5:7b
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_TEMPERATURE=0
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# ---------- Knowledge base (RAG) ----------
# Semantic search (by meaning) with an Ollama embedding model: `ollama pull nomic-embed-text`
# (~270 MB). Empty = keyword search (BM25) only. Re-sync after changing: payroll-chatbot kb
KB_EMBEDDING_MODEL=
KB_MIN_SIMILARITY=0.55

# ---------- API ----------
API_HOST=127.0.0.1
API_PORT=8000
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]   # React dev server

# ---------- Rules ----------
RULES_DIR=./config/rules
ALLOW_UNVERIFIED_RULES=true     # false => calculations refuse UNVERIFIED rule versions

# ---------- Payroll policy (company-specific; the LLM never decides these) ----------
DEFAULT_PAID_DAYS_BASIS=CALENDAR   # CALENDAR | FIXED_30 | FIXED_26 | WORKING_DAYS
DEFAULT_ROUNDING_MODE=HALF_UP      # HALF_UP | HALF_EVEN | CEIL | FLOOR | NONE
# LOP per day = LOP_BASE / LOP_DIVISOR
LOP_DIVISOR=CALENDAR               # FIXED_30 | CALENDAR | WORKING_DAYS
LOP_BASE=GROSS                     # GROSS | BASIC
LEAVE_ENTITLEMENTS={"CL": 12, "SL": 12, "EL": 18}   # days per financial year
