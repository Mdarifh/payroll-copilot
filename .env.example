# Copy this file to .env and fill real values. Never commit .env.

# ---------- App ----------
APP_ENV=dev                     # dev | test | prod
LOG_LEVEL=INFO                  # DEBUG | INFO | WARNING | ERROR
LOG_FORMAT=text                 # text | json

# ---------- Database ----------
# SQLite for development; later e.g. postgresql+psycopg://user:pass@host:5432/payroll
DATABASE_URL=sqlite:///./data/payroll.db

# ---------- LLM ----------
# Default: free local LLM via Ollama (https://ollama.com) -> `ollama pull qwen2.5:7b`
LLM_PROVIDER=ollama             # none | openai | anthropic | azure_openai | ollama
LLM_MODEL=qwen2.5:7b
LLM_TEMPERATURE=0

OPENAI_API_KEY=
ANTHROPIC_API_KEY=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_VERSION=
OLLAMA_BASE_URL=http://localhost:11434

# ---------- RAG ----------
EMBEDDING_PROVIDER=local        # local | openai | ollama
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
KNOWLEDGE_BASE_DIR=./knowledge_base
VECTOR_STORE_DIR=./data/chroma

# ---------- Rules ----------
RULES_DIR=./config/rules
ALLOW_UNVERIFIED_RULES=true     # false => calculations refuse UNVERIFIED rule versions

# ---------- Payroll defaults ----------
DEFAULT_PAID_DAYS_BASIS=CALENDAR   # CALENDAR | FIXED_30 | FIXED_26 | WORKING_DAYS
DEFAULT_ROUNDING_MODE=HALF_UP      # HALF_UP | HALF_EVEN | CEIL | FLOOR | NONE
DEFAULT_LOP_ALLOCATION=LAST_SEGMENT # LAST_SEGMENT | PROPORTIONAL (mid-month salary change)

# ---------- F&F policy (company-specific; verify with HR) ----------
FNF_LEAVE_ENCASHMENT_HEADS=["BASIC"]   # JSON list; ["GROSS"] = all gross earnings
FNF_LEAVE_ENCASHMENT_DIVISOR=30
FNF_NOTICE_RECOVERY_HEADS=["GROSS"]
FNF_NOTICE_RECOVERY_DIVISOR=30
COMPARISON_TOLERANCE=0             # rupees; expected vs actual allowed difference

# ---------- API ----------
API_HOST=127.0.0.1
API_PORT=8000
API_KEY=
API_BASE_URL=http://127.0.0.1:8000

# ---------- Agent memory / audit ----------
CHECKPOINT_DB=./data/checkpoints.db   # conversation memory (LangGraph SQLite checkpointer)
AUDIT_ENABLED=true                    # audit_logs table in DATABASE_URL (PII masked)

# ---------- Approvals (maker-checker) ----------
APPROVERS=[]                          # JSON list, e.g. ["alice","bob"]; empty = nobody approves
# Personal token per API user (JSON object). When set, X-User only counts together with
# the matching X-User-Token, so nobody can approve as someone else. Required in prod
# when APPROVERS is set. e.g. {"priya.hr":"long-random-1","hr.user":"long-random-2"}
USER_TOKENS={}
